<Window x:Class="ThreeLCS.Views.CustomLinksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Links" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Label" Binding="{Binding LinkLabel}" Width="200"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Link}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add" Command="{Binding AddCommand}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Remove" Command="{Binding RemoveCommand}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Open" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding SelectedLink}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
