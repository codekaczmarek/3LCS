<Window x:Class="ThreeLCS.Views.ChoosePackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        Title="Choose Package" Height="500" Width="800" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn Header="Package Type" Binding="{Binding PackageType}" Width="150"/>
                <DataGridTextColumn Header="Modified Date" Binding="{Binding ModifiedDate}" Width="150"/>
                <DataGridTextColumn Header="Modified By" Binding="{Binding ModifiedBy}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="0" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="OK" Command="{Binding SelectCommand}" Width="80" Margin="5,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
