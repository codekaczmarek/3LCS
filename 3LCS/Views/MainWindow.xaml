<Window x:Class="ThreeLCS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="600" Width="1000"
        WindowStyle="None"
        Icon="../Assets/favicon-white.ico"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="4"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Caption button styles -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8E1B10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Liveness icon cell template (shared by both grids) ─────────── -->
        <DataTemplate x:Key="LivenessCellTemplate">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"       Value="&#xE9CE;"/><!-- StatusCircleQuestionMark = unknown -->
                        <Setter Property="Foreground"  Value="#AAAAAA"/>
                        <Setter Property="ToolTip"     Value="Not yet checked"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Liveness}" Value="Checking">
                                <Setter Property="Text"      Value="&#xE72C;"/><!-- Refresh -->
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter Property="ToolTip"   Value="Checking…"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Liveness}" Value="Alive">
                                <Setter Property="Text"      Value="&#xE73E;"/><!-- Accept / checkmark -->
                                <Setter Property="Foreground" Value="#107C10"/>
                                <Setter Property="ToolTip"   Value="Responding on port 443/80"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Liveness}" Value="Unreachable">
                                <Setter Property="Text"      Value="&#xE783;"/><!-- Error (circle with X) -->
                                <Setter Property="Foreground" Value="#C42B1C"/>
                                <Setter Property="ToolTip"   Value="Not responding on port 443 or 80"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="CmdBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Shared environment tile template (used inside Favourites accordion) ─── -->
        <DataTemplate x:Key="EnvironmentTileTemplate">
            <Border Width="220" Margin="6" Padding="12,10"
                    CornerRadius="6" BorderThickness="1"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"  Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                        <Setter Property="BorderBrush" Value="#BBBBBB"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Instance.DeploymentStatus}" Value="{x:Null}">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="BorderBrush"     Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Logon to Application" Command="{Binding PlacementTarget.Tag.LogonToApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Open RDP"             Command="{Binding PlacementTarget.Tag.OpenRdpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="M 0,8 H 12 V 0 H 0 Z M 4,9 H 8 M 6,9 V 11 M 3,11 H 9" Stroke="#4A9EFF" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Start" Command="{Binding PlacementTarget.Tag.StartEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="M 0,0 L 10,5 L 0,10 Z" Fill="#2EA043" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Stop"  Command="{Binding PlacementTarget.Tag.StopEnvironmentCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon><Path Data="M 0,0 H 10 V 10 H 0 Z" Fill="#D1242F" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add NSG Rule"  Command="{Binding PlacementTarget.Tag.AddNsgRuleCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Apply Package" Command="{Binding PlacementTarget.Tag.ApplyPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="LCS Instance Links">
                            <MenuItem Header="Instance Details"             Command="{Binding PlacementTarget.Tag.OpenInstanceDetailsCommand,        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Environment Monitoring"       Command="{Binding PlacementTarget.Tag.OpenEnvironmentMonitoringCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Detailed Version Information" Command="{Binding PlacementTarget.Tag.OpenDetailedVersionInfoCommand,    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Environment Change History"   Command="{Binding PlacementTarget.Tag.OpenEnvironmentChangeHistoryCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Set friendly name…"
                                  Command="{Binding PlacementTarget.Tag.SetEnvironmentFriendlyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Remove from Favourites" Command="{Binding PlacementTarget.Tag.RemoveFromFavouritesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <!-- Liveness + Name row -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                        <ContentPresenter DockPanel.Dock="Left"
                                          ContentTemplate="{StaticResource LivenessCellTemplate}"
                                          Content="{Binding}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Instance.DisplayName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Instance.CurrentApplicationBuildVersion, StringFormat='App Build: {0}'}"/>
                                        <TextBlock Text="{Binding Instance.CurrentPlatformReleaseName, StringFormat='Platform: {0}'}"/>
                                        <TextBlock Text="{Binding Instance.DeployedBy, StringFormat='Deployed by: {0}'}"/>
                                        <TextBlock Text="{Binding Instance.DeployedOn, StringFormat='Deployed on: {0}'}"/>
                                        <TextBlock Text="{Binding Instance.TopologyDisplayName, StringFormat='Topology: {0}'}"/>
                                    </StackPanel>
                                </ToolTip>
                            </StackPanel.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EC;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"
                                           Foreground="#5C5C5C">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DisplayPrimary}"
                                           FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplaySecondary}"
                                       FontSize="10" Foreground="#888888" FontStyle="Italic"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <!-- Status badges -->
                    <DockPanel LastChildFill="True">
                        <!-- Transitional-state spinner (Starting / Stopping / Servicing) -->
                        <Grid DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,5,0"
                              VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransitional}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Stroke="#E0E0E0" StrokeThickness="1.5" Fill="Transparent"/>
                            <Ellipse Stroke="#0078D4" StrokeThickness="1.5" Fill="Transparent"
                                     StrokeDashArray="9 27"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding Instance.DeploymentStatus}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Instance.CurrentApplicationReleaseName}"
                               FontSize="11" Foreground="#444444"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ── Command Bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <!-- Outer grid: toolbar content + caption buttons overlay -->
            <Grid WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,3,138,3">

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                    <Image Source="../Assets/favicon-white.ico" Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="3LCS" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>

                <!-- Action groups -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Account -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding LoginToLcsCommand}" ToolTip="Login to LCS">
                        <StackPanel>
                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <TextBlock Text="Login" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding LogoutCommand}" ToolTip="Logout">
                        <StackPanel>
                            <TextBlock Text="&#xF3B1;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Logout" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="6,8" VerticalAlignment="Stretch"/>

                    <Button Style="{StaticResource CmdBtn}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)">
                        <StackPanel>
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <TextBlock Text="Refresh" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="6,8" VerticalAlignment="Stretch"/>

                    <!-- Export -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ExportToCsvCommand}" ToolTip="Export to CSV">
                        <StackPanel>
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Export CSV" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ExportToRdcManCommand}" ToolTip="Export to RDCMan">
                        <StackPanel>
                            <TextBlock Text="&#xE8AF;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="RDCMan" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="6,8" VerticalAlignment="Stretch"/>

                    <!-- Settings -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding CustomLinksCommand}" ToolTip="Custom Links">
                        <StackPanel>
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Links" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ParametersCommand}" ToolTip="Parameters / Settings">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Current project display / switch button -->
                <Button x:Name="ProjectSwitcherButton"
                        Grid.Column="1" Style="{StaticResource CmdBtn}"
                        Command="{Binding ChooseProjectCommand}"
                        ToolTip="Click to switch project"
                        Margin="4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                   Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding SelectedProject.Name, TargetNullValue='Choose project…'}"/>
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="#888888" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Right: About (column 4 = 138 px spacer reserved for OS caption buttons) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding AboutCommand}" ToolTip="About 3LCS">
                        <StackPanel>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

                <!-- Custom caption buttons overlay (top-right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionBtn}" Click="MinimizeButton_Click" ToolTip="Minimize" Height="32">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="MaximizeButton_Click" ToolTip="Maximize / Restore" Height="32">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;"/><!-- Maximize -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;"/><!-- Restore -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionBtn}" Click="CloseButton_Click" ToolTip="Close" Height="32">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="5"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <!-- ── Favourites ──────────────────────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="Home" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <!-- Loading overlay: shown while environments are being fetched and no groups exist yet -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FavouriteGroups.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsBusy}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Spinner -->
                        <Grid Width="32" Height="32" HorizontalAlignment="Center">
                            <Ellipse Stroke="#E0E0E0" StrokeThickness="3" Fill="Transparent"/>
                            <Ellipse Stroke="#0078D4" StrokeThickness="3" Fill="Transparent"
                                     StrokeDashArray="20 60"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="Loading favourites..."
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Foreground="#888888"/>
                    </StackPanel>

                    <!-- Empty-state overlay: shown when there are no favourite groups and not loading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FavouriteGroups.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE734;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="48" HorizontalAlignment="Center"
                                   Foreground="#CCCCCC"/>
                        <TextBlock Text="No favourites yet"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="#888888"/>
                        <TextBlock Text="Right-click a project in the Projects window or an environment in the Cloud-Hosted Environments tab and choose Add to Favourites."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="#AAAAAA" MaxWidth="420"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Accordion: one Expander per favourite project group -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FavouriteGroups}" Margin="6,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Margin="0,0,0,6">

                                        <!-- ── Header ── -->
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                                <StackPanel.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding Tag.OpenFavouriteProjectCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                                  CommandParameter="{Binding}"/>
                                                </StackPanel.InputBindings>
                                                <StackPanel.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open (switch to Cloud-Hosted)"
                                                                  Command="{Binding PlacementTarget.Tag.OpenFavouriteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Set friendly name…"
                                                                  Command="{Binding PlacementTarget.Tag.SetProjectFriendlyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <!-- Shown when NOT explicitly a favourite project -->
                                                        <MenuItem Header="★ Mark project as favourite"
                                                                  Command="{Binding PlacementTarget.Tag.MarkProjectFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsExplicitFavourite, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <!-- Shown when IS explicitly a favourite project -->
                                                        <MenuItem Header="Remove project from Favourites"
                                                                  Command="{Binding PlacementTarget.Tag.UnmarkProjectFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsExplicitFavourite, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </StackPanel.ContextMenu>

                                                <!-- Project icon -->
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                                           Margin="0,0,6,0"/>
                                                <!-- Tag icon (visible when alias set) -->
                                                <TextBlock Text="&#xE8EC;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                                           Foreground="#5C5C5C">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Primary: alias or real project name -->
                                                <TextBlock Text="{Binding DisplayPrimary}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Double-click to open this project"/>
                                                <!-- Real name subtitle (only when alias is set) -->
                                                <TextBlock Text="{Binding DisplaySecondary}"
                                                           FontSize="10" Foreground="#888888" FontStyle="Italic"
                                                           VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Explicit-favourite star -->
                                                <TextBlock Text=" ★"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Foreground="#F5A623"
                                                           ToolTip="Explicitly favourited project">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExplicitFavourite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Environment count badge -->
                                                <TextBlock FontSize="11" Foreground="#888888"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Text="{Binding Environments.Count, StringFormat='({0})'}"/>
                                            </StackPanel>
                                        </Expander.Header>

                                        <!-- ── Content ── -->
                                        <Grid>
                                            <!-- Empty-project placeholder -->
                                            <TextBlock Margin="12,8"
                                                       FontSize="11" Foreground="#AAAAAA" FontStyle="Italic"
                                                       Text="No favourite environments in this project — open the project to browse and add some.">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasEnvironments}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Environment tiles -->
                                            <ListBox ItemsSource="{Binding Environments}"
                                                     SelectedItem="{Binding DataContext.SelectedFavouriteRow,
                                                         RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasEnvironments}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" Margin="4,4,4,0"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="FavouriteTile_PreviewMouseRightButtonDown"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin"  Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentPresenter Content="{Binding}"
                                                                          ContentTemplate="{StaticResource EnvironmentTileTemplate}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>

                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- ── Cloud-Hosted Environments ──────────────────────────────── -->
            <TabItem Header="Cloud-Hosted Environments">
                <Grid>
                    <DataGrid ItemsSource="{Binding CheInstances}"
                              SelectedItem="{Binding SelectedCheRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Liveness icon -->
                            <DataGridTemplateColumn Header="" Width="28" CanUserSort="False" CanUserResize="False"
                                                    CellTemplate="{StaticResource LivenessCellTemplate}"/>
                            <DataGridTemplateColumn Header="Name" Width="200" SortMemberPath="DisplayPrimary">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8EC;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"
                                                           Foreground="#5C5C5C">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayPrimary}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplaySecondary}"
                                                       FontSize="10" Foreground="#888888" FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Instance ID" Binding="{Binding Instance.InstanceId}" Width="120"/>
                            <DataGridTextColumn Header="Environment ID" Binding="{Binding Instance.EnvironmentId}" Width="120"/>
                            <DataGridTextColumn Header="Deployment Status" Binding="{Binding Instance.DeploymentStatus}" Width="130"/>
                            <DataGridTextColumn Header="Deployment Action" Binding="{Binding Instance.DeploymentAction}" Width="130"/>
                            <DataGridTextColumn Header="App Build Version" Binding="{Binding Instance.CurrentApplicationBuildVersion}" Width="130"/>
                            <DataGridTextColumn Header="App Release Name" Binding="{Binding Instance.CurrentApplicationReleaseName}" Width="130"/>
                            <DataGridTextColumn Header="Platform Version" Binding="{Binding Instance.CurrentPlatformVersion}" Width="120"/>
                            <DataGridTextColumn Header="Platform Release Name" Binding="{Binding Instance.CurrentPlatformReleaseName}" Width="140"/>
                            <DataGridTextColumn Header="Build Info" Binding="{Binding Instance.BuildInfo}" Width="120"/>
                            <DataGridTextColumn Header="Deployed By" Binding="{Binding Instance.DeployedBy}" Width="120"/>
                            <DataGridTextColumn Header="Deployed On" Binding="{Binding Instance.DeployedOn}" Width="130"/>
                            <DataGridTextColumn Header="Topology" Binding="{Binding Instance.TopologyDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Topology Name" Binding="{Binding Instance.TopologyName}" Width="120"/>
                            <DataGridTextColumn Header="Topology Type" Binding="{Binding Instance.TopologyType}" Width="100"/>
                            <DataGridTextColumn Header="Topology Version" Binding="{Binding Instance.TopologyVersion}" Width="110"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Logon to Application" Command="{Binding PlacementTarget.DataContext.LogonToApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Open RDP" Command="{Binding PlacementTarget.DataContext.OpenRdpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon><Path Data="M 0,8 H 12 V 0 H 0 Z M 4,9 H 8 M 6,9 V 11 M 3,11 H 9" Stroke="#4A9EFF" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Start" Command="{Binding PlacementTarget.DataContext.StartEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon><Path Data="M 0,0 L 10,5 L 0,10 Z" Fill="#2EA043" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Stop" Command="{Binding PlacementTarget.DataContext.StopEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon><Path Data="M 0,0 H 10 V 10 H 0 Z" Fill="#D1242F" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Add NSG Rule" Command="{Binding PlacementTarget.DataContext.AddNsgRuleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Apply Package" Command="{Binding PlacementTarget.DataContext.ApplyPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="LCS Instance Links">
                                    <MenuItem Header="Instance Details" Command="{Binding PlacementTarget.DataContext.OpenInstanceDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Environment Monitoring" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentMonitoringCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Detailed Version Information" Command="{Binding PlacementTarget.DataContext.OpenDetailedVersionInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Environment Change History" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentChangeHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.DataContext.DeleteEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Set friendly name…"
                                          Command="{Binding PlacementTarget.DataContext.SetEnvironmentFriendlyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Add to Favourites" Command="{Binding PlacementTarget.DataContext.AddToFavouritesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Microsoft-Managed Environments">
                <DataGrid ItemsSource="{Binding SaasInstances}"
                          SelectedItem="{Binding SelectedSaasRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Liveness icon -->
                        <DataGridTemplateColumn Header="" Width="28" CanUserSort="False" CanUserResize="False"
                                                CellTemplate="{StaticResource LivenessCellTemplate}"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Instance.DisplayName}" Width="200"/>
                        <DataGridTextColumn Header="Instance ID" Binding="{Binding Instance.InstanceId}" Width="120"/>
                        <DataGridTextColumn Header="Environment ID" Binding="{Binding Instance.EnvironmentId}" Width="120"/>
                        <DataGridTextColumn Header="Deployment Status" Binding="{Binding Instance.DeploymentStatus}" Width="130"/>
                        <DataGridTextColumn Header="Deployment Action" Binding="{Binding Instance.DeploymentAction}" Width="130"/>
                        <DataGridTextColumn Header="App Build Version" Binding="{Binding Instance.CurrentApplicationBuildVersion}" Width="130"/>
                        <DataGridTextColumn Header="App Release Name" Binding="{Binding Instance.CurrentApplicationReleaseName}" Width="130"/>
                        <DataGridTextColumn Header="Platform Version" Binding="{Binding Instance.CurrentPlatformVersion}" Width="120"/>
                        <DataGridTextColumn Header="Platform Release Name" Binding="{Binding Instance.CurrentPlatformReleaseName}" Width="140"/>
                        <DataGridTextColumn Header="Build Info" Binding="{Binding Instance.BuildInfo}" Width="120"/>
                        <DataGridTextColumn Header="Deployed By" Binding="{Binding Instance.DeployedBy}" Width="120"/>
                        <DataGridTextColumn Header="Deployed On" Binding="{Binding Instance.DeployedOn}" Width="130"/>
                        <DataGridTextColumn Header="Topology" Binding="{Binding Instance.TopologyDisplayName}" Width="150"/>
                        <DataGridTextColumn Header="Topology Name" Binding="{Binding Instance.TopologyName}" Width="120"/>
                        <DataGridTextColumn Header="Topology Type" Binding="{Binding Instance.TopologyType}" Width="100"/>
                        <DataGridTextColumn Header="Topology Version" Binding="{Binding Instance.TopologyVersion}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- API Monitor panel (collapsible) -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                Background="#F9F9F9"
                Visibility="{Binding IsMonitorOpen, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{Binding ApiMonitor.RecentCalls}"
                      MaxHeight="180"
                      FontSize="11"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="60"
                                        DisplayMemberBinding="{Binding StartedAt, StringFormat=HH:mm:ss}"/>
                        <GridViewColumn Header="Method" Width="45"
                                        DisplayMemberBinding="{Binding Method}"/>
                        <GridViewColumn Header="URL" Width="380"
                                        DisplayMemberBinding="{Binding ShortUrl}"/>
                        <GridViewColumn Header="Status" Width="110"
                                        DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="ms" Width="60"
                                        DisplayMemberBinding="{Binding DurationMs}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Padding="2,1">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Circular spinner: visible only when busy -->
                    <Grid Width="14" Height="14" Margin="0,0,6,0"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Ellipse Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse Stroke="#0078D4" StrokeThickness="2" Fill="Transparent"
                                 StrokeDashArray="11 33"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <Trigger Property="IsVisible" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ApiMonitor.CurrentOperation}" Foreground="Gray" FontStyle="Italic"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Command="{Binding ShowBackgroundTasksCommand}"
                        Padding="6,1" FontSize="11" Cursor="Hand"
                        BorderThickness="0" Background="Transparent"
                        ToolTip="Show background tasks">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Tasks"/>
                        <TextBlock Margin="4,0,0,0"
                                   Text="{Binding TaskService.Tasks.Count}"
                                   Foreground="SteelBlue" FontWeight="Bold"
                                   Visibility="{Binding TaskService.Tasks.Count, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Button>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ToggleButton IsChecked="{Binding IsMonitorOpen}"
                              Padding="6,1" FontSize="11" Cursor="Hand"
                              BorderThickness="0" Background="Transparent"
                              ToolTip="Toggle API call monitor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="API Monitor"/>
                        <TextBlock Margin="4,0,0,0"
                                   Text="{Binding ApiMonitor.ActiveCallCount}"
                                   Foreground="SteelBlue" FontWeight="Bold"/>
                    </StackPanel>
                </ToggleButton>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
