<Window x:Class="ThreeLCS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="600" Width="1000"
        Icon="../Assets/favicon-white.ico"
        Background="#F5F5F5">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- ── Palette ──────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentBrush"        Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHoverBrush"   Color="#106EBE"/>
        <SolidColorBrush x:Key="AccentLightBrush"   Color="#EBF3FB"/>
        <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderColorBrush"   Color="#E1E1E1"/>
        <SolidColorBrush x:Key="HeaderBrush"        Color="#F0F0F0"/>
        <SolidColorBrush x:Key="AltRowBrush"        Color="#FAFAFA"/>
        <SolidColorBrush x:Key="SubtleTextBrush"    Color="#767676"/>
        <SolidColorBrush x:Key="BodyTextBrush"      Color="#1B1B1B"/>

        <!-- ── DataGrid ──────────────────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"                Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="RowBackground"             Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground"  Value="{StaticResource AltRowBrush}"/>
            <Setter Property="BorderBrush"               Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="GridLinesVisibility"       Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"  Value="#EFEFEF"/>
            <Setter Property="VerticalGridLinesBrush"    Value="Transparent"/>
            <Setter Property="HeadersVisibility"         Value="Column"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="Foreground"                Value="{StaticResource BodyTextBrush}"/>
            <Setter Property="RowHeaderWidth"            Value="0"/>
            <Setter Property="SelectionUnit"             Value="FullRow"/>
            <Setter Property="CanUserAddRows"            Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground"      Value="#444444"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight"  Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF5FC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="8,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"   Value="Transparent"/>
                    <Setter Property="BorderBrush"  Value="Transparent"/>
                    <Setter Property="Foreground"   Value="{StaticResource BodyTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TabControl: accent-underline style ────────────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="16,8,16,6"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.FontSize="12"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── StatusBar ─────────────────────────────────────────────────── -->
        <Style TargetType="StatusBar">
            <Setter Property="Background"      Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="{StaticResource SubtleTextBrush}"/>
        </Style>

        <!-- ── Menu bar ──────────────────────────────────────────────────── -->
        <Style TargetType="Menu">
            <Setter Property="Background"       Value="#F5F5F5"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Foreground"       Value="{StaticResource BodyTextBrush}"/>
            <Setter Property="Padding"          Value="4,2"/>
        </Style>

        <!-- Top-level menu items -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground"  Value="{StaticResource BodyTextBrush}"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconCol"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTCol"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="Icon" Grid.Column="0"
                                                  ContentSource="Icon" Margin="0,0,8,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Width="16" Height="16" SnapsToDevicePixels="True"/>

                                <ContentPresenter x:Name="Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>

                                <TextBlock x:Name="IGT" Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>

                                <!-- Arrow for sub-menus -->
                                <Path x:Name="Arrow" Grid.Column="3"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="{StaticResource SubtleTextBrush}"
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                                <!-- Popup for sub-menus -->
                                <Popup x:Name="PART_Popup" Grid.Column="0"
                                       AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4"
                                            Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    Grid.IsSharedSizeScope="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Top-level hover -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <!-- Top-level open -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                            <!-- Show arrow when has items -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd"    Property="Padding" Value="12,6"/>
                            </Trigger>
                            <!-- Submenu item style -->
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Bd"     Property="Padding"      Value="12,7"/>
                                <Setter TargetName="Arrow"  Property="Visibility"   Value="Collapsed"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                    <Condition Property="Role" Value="SubmenuItem"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"   Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="3"/>
                            </MultiTrigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Margin"      Value="8,3"/>
            <Setter Property="Background"  Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Login to LCS" Command="{Binding LoginToLcsCommand}"/>
                <MenuItem Header="L_ogout" Command="{Binding LogoutCommand}"/>
                <Separator/>
                <MenuItem Header="_Choose Project" Command="{Binding ChooseProjectCommand}"/>
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Export to CSV" Command="{Binding ExportToCsvCommand}"/>
                <MenuItem Header="Export to _RDCMan" Command="{Binding ExportToRdcManCommand}"/>
                <Separator/>
                <MenuItem Header="Custom _Links" Command="{Binding CustomLinksCommand}"/>
                <MenuItem Header="_Parameters" Command="{Binding ParametersCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="Cloud-Hosted Environments">
                <Grid>
                    <DataGrid ItemsSource="{Binding CheInstances}"
                              SelectedItem="{Binding SelectedCheRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Liveness indicator dot -->
                            <DataGridTemplateColumn Header="" Width="18" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <!-- Unknown: hollow grey ring -->
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Setter Property="Stroke" Value="#AAAAAA"/>
                                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                                    <Setter Property="ToolTip" Value="Not yet checked"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Liveness}" Value="Checking">
                                                            <Setter Property="Fill" Value="#5BA3E0"/>
                                                            <Setter Property="Stroke" Value="Transparent"/>
                                                            <Setter Property="ToolTip" Value="Checking…"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Liveness}" Value="Alive">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                            <Setter Property="Stroke" Value="Transparent"/>
                                                            <Setter Property="ToolTip" Value="Responding on port 443/80"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Liveness}" Value="Unreachable">
                                                            <Setter Property="Fill" Value="#E53935"/>
                                                            <Setter Property="Stroke" Value="Transparent"/>
                                                            <Setter Property="ToolTip" Value="Not responding on port 443 or 80"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Instance.DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Instance ID" Binding="{Binding Instance.InstanceId}" Width="120"/>
                            <DataGridTextColumn Header="Environment ID" Binding="{Binding Instance.EnvironmentId}" Width="120"/>
                            <DataGridTextColumn Header="Deployment Status" Binding="{Binding Instance.DeploymentStatus}" Width="130"/>
                            <DataGridTextColumn Header="Deployment Action" Binding="{Binding Instance.DeploymentAction}" Width="130"/>
                            <DataGridTextColumn Header="App Build Version" Binding="{Binding Instance.CurrentApplicationBuildVersion}" Width="130"/>
                            <DataGridTextColumn Header="App Release Name" Binding="{Binding Instance.CurrentApplicationReleaseName}" Width="130"/>
                            <DataGridTextColumn Header="Platform Version" Binding="{Binding Instance.CurrentPlatformVersion}" Width="120"/>
                            <DataGridTextColumn Header="Platform Release Name" Binding="{Binding Instance.CurrentPlatformReleaseName}" Width="140"/>
                            <DataGridTextColumn Header="Build Info" Binding="{Binding Instance.BuildInfo}" Width="120"/>
                            <DataGridTextColumn Header="Deployed By" Binding="{Binding Instance.DeployedBy}" Width="120"/>
                            <DataGridTextColumn Header="Deployed On" Binding="{Binding Instance.DeployedOn}" Width="130"/>
                            <DataGridTextColumn Header="Topology" Binding="{Binding Instance.TopologyDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Topology Name" Binding="{Binding Instance.TopologyName}" Width="120"/>
                            <DataGridTextColumn Header="Topology Type" Binding="{Binding Instance.TopologyType}" Width="100"/>
                            <DataGridTextColumn Header="Topology Version" Binding="{Binding Instance.TopologyVersion}" Width="110"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Logon to Application" Command="{Binding PlacementTarget.DataContext.LogonToApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Open RDP" Command="{Binding PlacementTarget.DataContext.OpenRdpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Start" Command="{Binding PlacementTarget.DataContext.StartEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Stop" Command="{Binding PlacementTarget.DataContext.StopEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Add NSG Rule" Command="{Binding PlacementTarget.DataContext.AddNsgRuleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Apply Package" Command="{Binding PlacementTarget.DataContext.ApplyPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="LCS Instance Links">
                                    <MenuItem Header="Instance Details" Command="{Binding PlacementTarget.DataContext.OpenInstanceDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Environment Monitoring" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentMonitoringCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Detailed Version Information" Command="{Binding PlacementTarget.DataContext.OpenDetailedVersionInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Environment Change History" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentChangeHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.DataContext.DeleteEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Microsoft-Managed Environments">
                <DataGrid ItemsSource="{Binding SaasInstances}"
                          SelectedItem="{Binding SelectedSaasRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Liveness indicator dot -->
                        <DataGridTemplateColumn Header="" Width="18" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Setter Property="Stroke" Value="#AAAAAA"/>
                                                <Setter Property="StrokeThickness" Value="1.5"/>
                                                <Setter Property="ToolTip" Value="Not yet checked"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Liveness}" Value="Checking">
                                                        <Setter Property="Fill" Value="#5BA3E0"/>
                                                        <Setter Property="Stroke" Value="Transparent"/>
                                                        <Setter Property="ToolTip" Value="Checking…"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Liveness}" Value="Alive">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                        <Setter Property="Stroke" Value="Transparent"/>
                                                        <Setter Property="ToolTip" Value="Responding on port 443/80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Liveness}" Value="Unreachable">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                        <Setter Property="Stroke" Value="Transparent"/>
                                                        <Setter Property="ToolTip" Value="Not responding on port 443 or 80"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Instance.DisplayName}" Width="200"/>
                        <DataGridTextColumn Header="Instance ID" Binding="{Binding Instance.InstanceId}" Width="120"/>
                        <DataGridTextColumn Header="Environment ID" Binding="{Binding Instance.EnvironmentId}" Width="120"/>
                        <DataGridTextColumn Header="Deployment Status" Binding="{Binding Instance.DeploymentStatus}" Width="130"/>
                        <DataGridTextColumn Header="Deployment Action" Binding="{Binding Instance.DeploymentAction}" Width="130"/>
                        <DataGridTextColumn Header="App Build Version" Binding="{Binding Instance.CurrentApplicationBuildVersion}" Width="130"/>
                        <DataGridTextColumn Header="App Release Name" Binding="{Binding Instance.CurrentApplicationReleaseName}" Width="130"/>
                        <DataGridTextColumn Header="Platform Version" Binding="{Binding Instance.CurrentPlatformVersion}" Width="120"/>
                        <DataGridTextColumn Header="Platform Release Name" Binding="{Binding Instance.CurrentPlatformReleaseName}" Width="140"/>
                        <DataGridTextColumn Header="Build Info" Binding="{Binding Instance.BuildInfo}" Width="120"/>
                        <DataGridTextColumn Header="Deployed By" Binding="{Binding Instance.DeployedBy}" Width="120"/>
                        <DataGridTextColumn Header="Deployed On" Binding="{Binding Instance.DeployedOn}" Width="130"/>
                        <DataGridTextColumn Header="Topology" Binding="{Binding Instance.TopologyDisplayName}" Width="150"/>
                        <DataGridTextColumn Header="Topology Name" Binding="{Binding Instance.TopologyName}" Width="120"/>
                        <DataGridTextColumn Header="Topology Type" Binding="{Binding Instance.TopologyType}" Width="100"/>
                        <DataGridTextColumn Header="Topology Version" Binding="{Binding Instance.TopologyVersion}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- API Monitor panel (collapsible) -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                Background="#F9F9F9"
                Visibility="{Binding IsMonitorOpen, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{Binding ApiMonitor.RecentCalls}"
                      MaxHeight="180"
                      FontSize="11"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="60"
                                        DisplayMemberBinding="{Binding StartedAt, StringFormat=HH:mm:ss}"/>
                        <GridViewColumn Header="Method" Width="45"
                                        DisplayMemberBinding="{Binding Method}"/>
                        <GridViewColumn Header="URL" Width="380"
                                        DisplayMemberBinding="{Binding ShortUrl}"/>
                        <GridViewColumn Header="Status" Width="110"
                                        DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="ms" Width="60"
                                        DisplayMemberBinding="{Binding DurationMs}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Circular spinner: visible only when busy -->
                    <Grid Width="14" Height="14" Margin="0,0,6,0"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Ellipse Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse Stroke="#0078D4" StrokeThickness="2" Fill="Transparent"
                                 StrokeDashArray="11 33"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <Trigger Property="IsVisible" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ApiMonitor.CurrentOperation}" Foreground="Gray" FontStyle="Italic"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ToggleButton IsChecked="{Binding IsMonitorOpen}"
                              Padding="6,1" FontSize="11" Cursor="Hand"
                              BorderThickness="0" Background="Transparent"
                              ToolTip="Toggle API call monitor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="API Monitor"/>
                        <TextBlock Margin="4,0,0,0"
                                   Text="{Binding ApiMonitor.ActiveCallCount}"
                                   Foreground="SteelBlue" FontWeight="Bold"/>
                    </StackPanel>
                </ToggleButton>
            </StatusBarItem>
        </StatusBar>

        <!-- Taskbar icon -->
        <tb:TaskbarIcon x:Name="TrayIcon" Grid.Row="0"                        IconSource="../Assets/favicon-white.ico"
                        ToolTipText="3LCS"/>
    </Grid>
</Window>
