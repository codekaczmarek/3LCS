<Window x:Class="ThreeLCS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="600" Width="1000"
        Icon="../Assets/favicon-white.ico"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- ── Liveness icon cell template (shared by both grids) ─────────── -->
        <DataTemplate x:Key="LivenessCellTemplate">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"       Value="&#xE9CE;"/><!-- StatusCircleQuestionMark = unknown -->
                        <Setter Property="Foreground"  Value="#AAAAAA"/>
                        <Setter Property="ToolTip"     Value="Not yet checked"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Liveness}" Value="Checking">
                                <Setter Property="Text"      Value="&#xE72C;"/><!-- Refresh -->
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter Property="ToolTip"   Value="Checking…"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Liveness}" Value="Alive">
                                <Setter Property="Text"      Value="&#xE73E;"/><!-- Accept / checkmark -->
                                <Setter Property="Foreground" Value="#107C10"/>
                                <Setter Property="ToolTip"   Value="Responding on port 443/80"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Liveness}" Value="Unreachable">
                                <Setter Property="Text"      Value="&#xE783;"/><!-- Error (circle with X) -->
                                <Setter Property="Foreground" Value="#C42B1C"/>
                                <Setter Property="ToolTip"   Value="Not responding on port 443 or 80"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="CmdBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ── Command Bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,3">

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                    <Image Source="../Assets/favicon-white.ico" Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="3LCS" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>

                <!-- Action groups -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Account -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding LoginToLcsCommand}" ToolTip="Login to LCS">
                        <StackPanel>
                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <TextBlock Text="Login" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding LogoutCommand}" ToolTip="Logout">
                        <StackPanel>
                            <TextBlock Text="&#xF3B1;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Logout" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="6,8" VerticalAlignment="Stretch"/>

                    <!-- Project -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ChooseProjectCommand}" ToolTip="Choose Project">
                        <StackPanel>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Project" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)">
                        <StackPanel>
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <TextBlock Text="Refresh" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="6,8" VerticalAlignment="Stretch"/>

                    <!-- Export -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ExportToCsvCommand}" ToolTip="Export to CSV">
                        <StackPanel>
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Export CSV" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ExportToRdcManCommand}" ToolTip="Export to RDCMan">
                        <StackPanel>
                            <TextBlock Text="&#xE8AF;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="RDCMan" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="6,8" VerticalAlignment="Stretch"/>

                    <!-- Settings -->
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding CustomLinksCommand}" ToolTip="Custom Links">
                        <StackPanel>
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Links" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding ParametersCommand}" ToolTip="Parameters / Settings">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: About + Exit -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CmdBtn}" Command="{Binding AboutCommand}" ToolTip="About 3LCS">
                        <StackPanel>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CmdBtn}" Click="ExitMenuItem_Click" ToolTip="Exit 3LCS">
                        <StackPanel>
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Exit" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="Cloud-Hosted Environments">
                <Grid>
                    <DataGrid ItemsSource="{Binding CheInstances}"
                              SelectedItem="{Binding SelectedCheRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              FontSize="11">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="MinHeight" Value="24"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Liveness icon -->
                            <DataGridTemplateColumn Header="" Width="28" CanUserSort="False" CanUserResize="False"
                                                    CellTemplate="{StaticResource LivenessCellTemplate}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Instance.DisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Instance ID" Binding="{Binding Instance.InstanceId}" Width="120"/>
                            <DataGridTextColumn Header="Environment ID" Binding="{Binding Instance.EnvironmentId}" Width="120"/>
                            <DataGridTextColumn Header="Deployment Status" Binding="{Binding Instance.DeploymentStatus}" Width="130"/>
                            <DataGridTextColumn Header="Deployment Action" Binding="{Binding Instance.DeploymentAction}" Width="130"/>
                            <DataGridTextColumn Header="App Build Version" Binding="{Binding Instance.CurrentApplicationBuildVersion}" Width="130"/>
                            <DataGridTextColumn Header="App Release Name" Binding="{Binding Instance.CurrentApplicationReleaseName}" Width="130"/>
                            <DataGridTextColumn Header="Platform Version" Binding="{Binding Instance.CurrentPlatformVersion}" Width="120"/>
                            <DataGridTextColumn Header="Platform Release Name" Binding="{Binding Instance.CurrentPlatformReleaseName}" Width="140"/>
                            <DataGridTextColumn Header="Build Info" Binding="{Binding Instance.BuildInfo}" Width="120"/>
                            <DataGridTextColumn Header="Deployed By" Binding="{Binding Instance.DeployedBy}" Width="120"/>
                            <DataGridTextColumn Header="Deployed On" Binding="{Binding Instance.DeployedOn}" Width="130"/>
                            <DataGridTextColumn Header="Topology" Binding="{Binding Instance.TopologyDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Topology Name" Binding="{Binding Instance.TopologyName}" Width="120"/>
                            <DataGridTextColumn Header="Topology Type" Binding="{Binding Instance.TopologyType}" Width="100"/>
                            <DataGridTextColumn Header="Topology Version" Binding="{Binding Instance.TopologyVersion}" Width="110"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Logon to Application" Command="{Binding PlacementTarget.DataContext.LogonToApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Open RDP" Command="{Binding PlacementTarget.DataContext.OpenRdpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Start" Command="{Binding PlacementTarget.DataContext.StartEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Stop" Command="{Binding PlacementTarget.DataContext.StopEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Add NSG Rule" Command="{Binding PlacementTarget.DataContext.AddNsgRuleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Apply Package" Command="{Binding PlacementTarget.DataContext.ApplyPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="LCS Instance Links">
                                    <MenuItem Header="Instance Details" Command="{Binding PlacementTarget.DataContext.OpenInstanceDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Environment Monitoring" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentMonitoringCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Detailed Version Information" Command="{Binding PlacementTarget.DataContext.OpenDetailedVersionInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Environment Change History" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentChangeHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.DataContext.DeleteEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Microsoft-Managed Environments">
                <DataGrid ItemsSource="{Binding SaasInstances}"
                          SelectedItem="{Binding SelectedSaasRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          FontSize="11">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="MinHeight" Value="24"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Liveness icon -->
                        <DataGridTemplateColumn Header="" Width="28" CanUserSort="False" CanUserResize="False"
                                                CellTemplate="{StaticResource LivenessCellTemplate}"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Instance.DisplayName}" Width="200"/>
                        <DataGridTextColumn Header="Instance ID" Binding="{Binding Instance.InstanceId}" Width="120"/>
                        <DataGridTextColumn Header="Environment ID" Binding="{Binding Instance.EnvironmentId}" Width="120"/>
                        <DataGridTextColumn Header="Deployment Status" Binding="{Binding Instance.DeploymentStatus}" Width="130"/>
                        <DataGridTextColumn Header="Deployment Action" Binding="{Binding Instance.DeploymentAction}" Width="130"/>
                        <DataGridTextColumn Header="App Build Version" Binding="{Binding Instance.CurrentApplicationBuildVersion}" Width="130"/>
                        <DataGridTextColumn Header="App Release Name" Binding="{Binding Instance.CurrentApplicationReleaseName}" Width="130"/>
                        <DataGridTextColumn Header="Platform Version" Binding="{Binding Instance.CurrentPlatformVersion}" Width="120"/>
                        <DataGridTextColumn Header="Platform Release Name" Binding="{Binding Instance.CurrentPlatformReleaseName}" Width="140"/>
                        <DataGridTextColumn Header="Build Info" Binding="{Binding Instance.BuildInfo}" Width="120"/>
                        <DataGridTextColumn Header="Deployed By" Binding="{Binding Instance.DeployedBy}" Width="120"/>
                        <DataGridTextColumn Header="Deployed On" Binding="{Binding Instance.DeployedOn}" Width="130"/>
                        <DataGridTextColumn Header="Topology" Binding="{Binding Instance.TopologyDisplayName}" Width="150"/>
                        <DataGridTextColumn Header="Topology Name" Binding="{Binding Instance.TopologyName}" Width="120"/>
                        <DataGridTextColumn Header="Topology Type" Binding="{Binding Instance.TopologyType}" Width="100"/>
                        <DataGridTextColumn Header="Topology Version" Binding="{Binding Instance.TopologyVersion}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- API Monitor panel (collapsible) -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                Background="#F9F9F9"
                Visibility="{Binding IsMonitorOpen, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{Binding ApiMonitor.RecentCalls}"
                      MaxHeight="180"
                      FontSize="11"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="60"
                                        DisplayMemberBinding="{Binding StartedAt, StringFormat=HH:mm:ss}"/>
                        <GridViewColumn Header="Method" Width="45"
                                        DisplayMemberBinding="{Binding Method}"/>
                        <GridViewColumn Header="URL" Width="380"
                                        DisplayMemberBinding="{Binding ShortUrl}"/>
                        <GridViewColumn Header="Status" Width="110"
                                        DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="ms" Width="60"
                                        DisplayMemberBinding="{Binding DurationMs}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Circular spinner: visible only when busy -->
                    <Grid Width="14" Height="14" Margin="0,0,6,0"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Ellipse Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse Stroke="#0078D4" StrokeThickness="2" Fill="Transparent"
                                 StrokeDashArray="11 33"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <Trigger Property="IsVisible" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ApiMonitor.CurrentOperation}" Foreground="Gray" FontStyle="Italic"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ToggleButton IsChecked="{Binding IsMonitorOpen}"
                              Padding="6,1" FontSize="11" Cursor="Hand"
                              BorderThickness="0" Background="Transparent"
                              ToolTip="Toggle API call monitor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="API Monitor"/>
                        <TextBlock Margin="4,0,0,0"
                                   Text="{Binding ApiMonitor.ActiveCallCount}"
                                   Foreground="SteelBlue" FontWeight="Bold"/>
                    </StackPanel>
                </ToggleButton>
            </StatusBarItem>
        </StatusBar>

        <!-- Taskbar icon -->
        <tb:TaskbarIcon x:Name="TrayIcon" Grid.Row="0"                        IconSource="../Assets/favicon-white.ico"
                        ToolTipText="3LCS"/>
    </Grid>
</Window>
