<Window x:Class="ThreeLCS.Views.ChooseProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        Title="Choose Project" Height="550" Width="900"
        WindowStyle="None" WindowStartupLocation="Manual">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="4"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <!-- Close caption button style (matching MainWindow) -->
        <Style x:Key="CloseCaptionBtn" TargetType="Button">
            <Setter Property="Width"            Value="46"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8E1B10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid RowDefinitions="Auto,*">
        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Height="48">
            <Grid WindowChrome.IsHitTestVisibleInChrome="True" ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Col 0: title -->
                <TextBlock Grid.Column="0" Text="Choose Project" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <!-- Col 1: spinner (shown while loading) -->
                <Grid Grid.Column="1" Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Ellipse Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent"/>
                    <Ellipse Stroke="#0078D4" StrokeThickness="2" Fill="Transparent"
                             StrokeDashArray="11 33"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.9"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <!-- Col 2: search input — stretches into available space -->
                <TextBox Grid.Column="2" x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,8,8,8"
                         Padding="4,2" VerticalContentAlignment="Center"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <!-- Col 3: close button -->
                <Button Grid.Column="3" Style="{StaticResource CloseCaptionBtn}" Command="{Binding CancelCommand}"
                        VerticalAlignment="Top" Height="44">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Project grid -->
            <DataGrid Grid.Row="0"
                      x:Name="ProjectGrid"
                      ItemsSource="{Binding FilteredProjects}"
                      SelectedItem="{Binding SelectedProject}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Tag="{Binding}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add to Favourites"    Command="{Binding PlacementTarget.Tag.AddProjectToFavouritesCommand,    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Remove from Favourites" Command="{Binding PlacementTarget.Tag.RemoveProjectFromFavouritesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Set friendly name…"  Command="{Binding PlacementTarget.Tag.SetProjectFriendlyNameCommand,      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- Favourite star -->
                    <DataGridTemplateColumn Header="★" Width="28" CanUserSort="True" SortMemberPath="Favorite" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="★" HorizontalAlignment="Center" FontSize="13"
                                           Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"
                                           Foreground="#F5A623" ToolTip="Favourite"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" Width="220" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Organization"  Binding="{Binding OrganizationName}" Width="160"/>
                    <DataGridTextColumn Header="Type"          Binding="{Binding ProjectTypeId}" Width="130"/>
                    <DataGridTextColumn Header="Product"       Binding="{Binding ProductId}" Width="110"/>
                    <DataGridTextColumn Header="Version"       Binding="{Binding ProductVersionId}" Width="110"/>
                    <DataGridTextColumn Header="ID"            Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Description"   Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Status / error text -->
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="OrangeRed"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" Command="{Binding SelectProjectCommand}" Width="80" Margin="5,0"
                        IsDefault="True"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

