<Window x:Class="ThreeLCS.Views.ChooseProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        Title="Choose Project" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>
    <Grid>
        <Grid Margin="10" IsEnabled="{Binding IsNotBusy}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍  Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="4,3"/>
            </Grid>

            <!-- Project grid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredProjects}"
                      SelectedItem="{Binding SelectedProject}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Favourite star -->
                    <DataGridTemplateColumn Header="★" Width="28" CanUserSort="True" SortMemberPath="Favorite" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="★" HorizontalAlignment="Center" FontSize="13"
                                           Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"
                                           Foreground="#F5A623" ToolTip="Favourite"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" Width="220" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Organization"  Binding="{Binding OrganizationName}" Width="160"/>
                    <DataGridTextColumn Header="Type"          Binding="{Binding ProjectTypeId}" Width="130"/>
                    <DataGridTextColumn Header="Product"       Binding="{Binding ProductId}" Width="110"/>
                    <DataGridTextColumn Header="Version"       Binding="{Binding ProductVersionId}" Width="110"/>
                    <DataGridTextColumn Header="ID"            Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Description"   Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Status / error text -->
            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="OrangeRed"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" Command="{Binding SelectProjectCommand}" Width="80" Margin="5,0"
                        IsDefault="True"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- Loading overlay -->
        <Grid Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="Loading projects…" Foreground="White" HorizontalAlignment="Center"
                           Margin="0,8,0,0" FontSize="13"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

