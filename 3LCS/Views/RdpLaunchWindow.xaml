<Window x:Class="ThreeLCS.Views.RdpLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDP Connect" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- Status icon + text -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="22"
                       VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Text" Value="&#xEC59;"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                <Setter Property="Text" Value="&#xE73E;"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="13"
                       MaxWidth="330"/>
        </StackPanel>

        <!-- Progress bar (while busy) -->
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,14"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- Countdown badge -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14"
                    Visibility="{Binding IsCountdownVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                    CornerRadius="14" Width="28" Height="28">
                <TextBlock Text="{Binding Countdown}" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <!-- Account picker (shown only when multiple accounts available) -->
        <StackPanel Visibility="{Binding IsUserPickerVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,14">
            <ListBox ItemsSource="{Binding RdpList}"
                     SelectedItem="{Binding SelectedConnection}"
                     MaxHeight="160"
                     Margin="0,6,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding Machine}" FontWeight="SemiBold" MinWidth="140"/>
                            <TextBlock Text=" — " Foreground="Gray"/>
                            <TextBlock Text="{Binding Username}" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Connect with selected account"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Cancel / Close button -->
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"
                Style="{StaticResource ActionButton}"
                HorizontalAlignment="Right"
                Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}"/>

    </StackPanel>
</Window>
