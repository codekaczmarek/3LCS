<Window x:Class="ThreeLCS.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16,14,16,14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox"
                 MinWidth="300" Padding="4,3"
                 KeyDown="InputBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="75" IsDefault="True"
                    Click="OK_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="75" IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
