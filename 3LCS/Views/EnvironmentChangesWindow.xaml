<Window x:Class="ThreeLCS.Views.EnvironmentChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        Title="Environment Changes" Height="500" Width="800" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Actions}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Action Type" Binding="{Binding ActionType}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding ActionStatusText}" Width="150"/>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="150"/>
                <DataGridTextColumn Header="Completion Date" Binding="{Binding CompletionDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="0" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Button Grid.Row="1" Content="Close" Command="{Binding CloseCommand}" Width="80" HorizontalAlignment="Right" Margin="5"/>
    </Grid>
</Window>
