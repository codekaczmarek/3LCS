<Window x:Class="ThreeLCS.Views.ParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameters" Height="520" Width="500"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12" RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>

                <!-- General -->
                <GroupBox Header="General" Margin="0,0,0,8" Padding="8">
                    <StackPanel>
                        <CheckBox Content="Enable Caching" IsChecked="{Binding CachingEnabled}" Margin="0,2"/>
                        <CheckBox Content="Keep Cache" IsChecked="{Binding KeepCache}" Margin="0,2"/>
                        <CheckBox Content="Always Log as Admin" IsChecked="{Binding AlwaysLogAsAdmin}" IsEnabled="False" Margin="0,2"/>
                        <CheckBox Content="Auto Refresh" IsChecked="{Binding AutoRefresh}" IsEnabled="False" Margin="0,2"/>
                        <CheckBox Content="Check environment liveness (TCP port 443/80)" IsChecked="{Binding LivenessCheckEnabled}" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>

                <!-- GEO -->
                <GroupBox Header="LCS GEO Region" Margin="0,0,0,8" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Region:" VerticalAlignment="Center" Width="80"/>
                            <ComboBox ItemsSource="{Binding GeoPresets}"
                                      SelectedItem="{Binding SelectedGeo}"
                                      DisplayMemberPath="Name"
                                      Width="200"/>
                        </StackPanel>

                        <Grid IsEnabled="{Binding UrlsAreCustom}"
                              ColumnDefinitions="90,*"
                              RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="LCS URL:"    VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding LcsUrl}"       Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Update URL:" VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding LcsUpdateUrl}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Diag URL:"   VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding LcsDiagUrl}"   Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Fix URL:"    VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding LcsFixUrl}"    Margin="0,2"/>
                        </Grid>

                        <TextBlock Text="⚠ Changing the region will clear your saved session and restart the app."
                                   Foreground="DarkOrange" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons pinned to bottom -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save"   Command="{Binding SaveCommand}"   Width="80" Margin="5,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>

    </Grid>
</Window>
