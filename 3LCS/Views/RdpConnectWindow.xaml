<Window x:Class="ThreeLCS.Views.RdpConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connecting..." Height="200" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="300" Height="20" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
