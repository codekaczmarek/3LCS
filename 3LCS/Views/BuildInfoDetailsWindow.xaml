<Window x:Class="ThreeLCS.Views.BuildInfoDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        Title="Build Info Details" Height="600" Width="700" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding BuildInfo.BuildInfoTreeView}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="150"/>
                <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="150"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="150"/>
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="80"/>
                <DataGridTextColumn Header="Installed Date" Binding="{Binding InstalledDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StatusBar Grid.Row="1">
            <TextBlock Text="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}"/>
        </StatusBar>
        <Grid Grid.Row="0" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
