<Window x:Class="ThreeLCS.Views.PowerShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ThreeLCS.Views.Converters"
        Title="PowerShell" Height="500" Width="700" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Script" Margin="0,0,0,5">
            <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Output" Margin="0,0,0,5">
            <TextBox Text="{Binding Output}" IsReadOnly="True"
                     AcceptsReturn="True" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Run" Command="{Binding RunCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                    Width="80" Margin="5,0"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
