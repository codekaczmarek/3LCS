<Window x:Class="ThreeLCS.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credentials" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding EnvironmentName}" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Credentials}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username / Key" Binding="{Binding Key}" Width="250"/>
                <DataGridTextColumn Header="Password / Value" Binding="{Binding Value}" Width="250"/>
                <DataGridTemplateColumn Header="Copy" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Copy" Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Close" Command="{Binding CloseCommand}" Width="80" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
