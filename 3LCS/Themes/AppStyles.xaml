<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         Caption button styles
    ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width"           Value="46"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionBtn" TargetType="Button">
        <Setter Property="Width"           Value="46"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8E1B10"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         Command bar button style
    ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CmdBtn" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="10,6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         Liveness icon cell template (shared by both grids)
    ═══════════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="LivenessCellTemplate">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   SnapsToDevicePixels="True">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text"       Value="&#xE9CE;"/>
                    <Setter Property="Foreground"  Value="#AAAAAA"/>
                    <Setter Property="ToolTip"     Value="Not yet checked"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Liveness}" Value="Checking">
                            <Setter Property="Text"      Value="&#xE72C;"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <Setter Property="ToolTip"   Value="Checking…"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Liveness}" Value="Alive">
                            <Setter Property="Text"      Value="&#xE73E;"/>
                            <Setter Property="Foreground" Value="#107C10"/>
                            <Setter Property="ToolTip"   Value="Responding on port 443/80"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Liveness}" Value="Unreachable">
                            <Setter Property="Text"      Value="&#xE783;"/>
                            <Setter Property="Foreground" Value="#C42B1C"/>
                            <Setter Property="ToolTip"   Value="Not responding on port 443 or 80"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         Shared environment tile template (Favourites accordion)
    ═══════════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="EnvironmentTileTemplate">
        <Border Width="220" Margin="6" Padding="12,10"
                CornerRadius="6" BorderThickness="1"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"  Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="#BBBBBB"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Instance.DeploymentStatus}" Value="{x:Null}">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="BorderBrush"     Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Logon to Application" Command="{Binding PlacementTarget.Tag.LogonToApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Open RDP"             Command="{Binding PlacementTarget.Tag.OpenRdpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Path Data="M 0,8 H 12 V 0 H 0 Z M 4,9 H 8 M 6,9 V 11 M 3,11 H 9" Stroke="#4A9EFF" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Start" Command="{Binding PlacementTarget.Tag.StartEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Path Data="M 0,0 L 10,5 L 0,10 Z" Fill="#2EA043" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stop"  Command="{Binding PlacementTarget.Tag.StopEnvironmentCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Path Data="M 0,0 H 10 V 10 H 0 Z" Fill="#D1242F" Stretch="Uniform" Width="12" Height="12"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Add NSG Rule"  Command="{Binding PlacementTarget.Tag.AddNsgRuleCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Apply Package" Command="{Binding PlacementTarget.Tag.ApplyPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="LCS Instance Links">
                        <MenuItem Header="Instance Details"             Command="{Binding PlacementTarget.Tag.OpenInstanceDetailsCommand,        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Environment Monitoring"       Command="{Binding PlacementTarget.Tag.OpenEnvironmentMonitoringCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Detailed Version Information" Command="{Binding PlacementTarget.Tag.OpenDetailedVersionInfoCommand,    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Environment Change History"   Command="{Binding PlacementTarget.Tag.OpenEnvironmentChangeHistoryCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Set friendly name…"
                              Command="{Binding PlacementTarget.Tag.SetEnvironmentFriendlyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Remove from Favourites" Command="{Binding PlacementTarget.Tag.RemoveFromFavouritesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
                <!-- Liveness + Name row -->
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <ContentPresenter DockPanel.Dock="Left"
                                      ContentTemplate="{StaticResource LivenessCellTemplate}"
                                      Content="{Binding}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Instance.DisplayName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Instance.CurrentApplicationBuildVersion, StringFormat='App Build: {0}'}"/>
                                    <TextBlock Text="{Binding Instance.CurrentPlatformReleaseName, StringFormat='Platform: {0}'}"/>
                                    <TextBlock Text="{Binding Instance.DeployedBy, StringFormat='Deployed by: {0}'}"/>
                                    <TextBlock Text="{Binding Instance.DeployedOn, StringFormat='Deployed on: {0}'}"/>
                                    <TextBlock Text="{Binding Instance.TopologyDisplayName, StringFormat='Topology: {0}'}"/>
                                </StackPanel>
                            </ToolTip>
                        </StackPanel.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EC;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"
                                       Foreground="#5C5C5C">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DisplayPrimary}"
                                       FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplaySecondary}"
                                   FontSize="10" Foreground="#888888" FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFriendlyName}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <!-- Status badges -->
                <DockPanel LastChildFill="True">
                    <!-- Transitional-state spinner (Starting / Stopping / Servicing) -->
                    <Grid DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,5,0"
                          VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransitional}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Stroke="#E0E0E0" StrokeThickness="1.5" Fill="Transparent"/>
                        <Ellipse Stroke="#0078D4" StrokeThickness="1.5" Fill="Transparent"
                                 StrokeDashArray="9 27"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <Trigger Property="IsVisible" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding Instance.DeploymentStatus}"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding Instance.CurrentApplicationReleaseName}"
                           FontSize="11" Foreground="#444444"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         Global DataGrid compactness
    ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="DataGrid">
        <Setter Property="FontSize"       Value="11"/>
        <Setter Property="RowHeaderWidth"  Value="0"/>
        <Setter Property="CanUserAddRows"  Value="False"/>
        <Setter Property="SelectionUnit"   Value="FullRow"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="20"/>
    </Style>

</ResourceDictionary>
